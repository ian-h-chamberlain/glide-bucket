{
    "version": "0.1.63a",
    "homepage": "https://glide-browser.app/",
    "license": "MPL-2.0",
    "description": "An extensible and keyboard-focused web browser",
    "architecture": {
        "64bit": {
            "url": "https://github.com/glide-browser/glide/releases/download/0.1.63a/glide.windows-x86_64.installer.exe#/dl.7z",
            "hash": "5f04709aa089a34b186bf2f68d8f46c2e120fcab5e759539d3c60ed73f4df4ab"
        },
        "arm64": {
            "url": "https://github.com/glide-browser/glide/releases/download/0.1.63a/glide.windows-aarch64.installer.exe#/dl.7z",
            "hash": "2d3419a5e6b1494aa0031f9234616260c907f822d5ead3535b03ebb9aca14cbf"
        }
    },
    "extract_dir": "core",
    "post_install": [
        "glide -CreateProfile \"Scoop $persist_dir\\profile\"",
        "$Addition = \"$persist_dir\\addition\"",
        "if (Test-Path $Addition) {",
        "  info 'Copying additional items...'",
        "  Copy-Item -Path $Addition\\* -Destination $dir -Force -Recurse -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": "glide.exe",
    "shortcuts": [
        [
            "glide.exe",
            "Glide"
        ],
        [
            "glide.exe",
            "Glide Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "checkver": {
        "github": "https://github.com/glide-browser/glide",
        "regex": "releases/tag/([\\d.]+[a-z]?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/glide-browser/glide/releases/download/$version/glide.windows-x86_64.installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/glide-browser/glide/releases/download/$version/glide.windows-aarch64.installer.exe#/dl.7z"
            }
        }
    }
}
