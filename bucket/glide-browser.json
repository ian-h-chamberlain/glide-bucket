{
    "version": "0.1.60a",
    "homepage": "https://glide-browser.app/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/glide-browser/glide/releases/download/0.1.60a/glide.windows-x86_64.installer.exe#/dl.7z",
            "hash": "sha256:44128cb9cbcd8b49909e28ee7bb8ffd2cbef0a772028b432194f9aa6e19205b6"
        },
        "arm64": {
            "url": "https://github.com/glide-browser/glide/releases/download/0.1.60a/glide.windows-aarch64.installer.exe#/dl.7z",
            "hash": "sha256:2e22c778bff0a864619ca22037095f47b772fbce75438d316d2e0333ff7d1a9f"
        }
    },
    "extract_dir": "core",
    "post_install": [
        "glide -CreateProfile \"Scoop $persist_dir\\profile\"",
        "$Addition = \"$persist_dir\\addition\"",
        "if (Test-Path $Addition) {",
        "  info 'Copying additional items...'",
        "  Copy-Item -Path $Addition\\* -Destination $dir -Force -Recurse -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": "glide.exe",
    "shortcuts": [
        [
            "glide.exe",
            "Glide"
        ],
        [
            "glide.exe",
            "Glide Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "checkver": {
        "github": "https://github.com/glide-browser/glide"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/glide-browser/glide/releases/download/$version/glide.windows-x86_64.installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/glide-browser/glide/releases/download/$version/glide.windows-aarch64.installer.exe#/dl.7z"
            }
        }
    }
}
